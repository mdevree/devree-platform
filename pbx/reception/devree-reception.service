[Unit]
Description=De Vree durable PBX reception sync
After=network-online.target
Wants=network-online.target
[Service]
User=asterisk
Group=asterisk
EnvironmentFile=/etc/devree-reception.env
ExecStart=/usr/bin/python3 /opt/devree-reception/reception.py worker
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/devree-reception
UMask=0027
[Install]
WantedBy=multi-user.target
