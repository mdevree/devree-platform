[Unit]
Description=De Vree marketingstatistieken uit Postiz
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=DeVreeMakelaardij
Group=DeVreeMakelaardij
Environment=HOME=/home/DeVreeMakelaardij
ExecStart=/usr/bin/python3 /home/DeVreeMakelaardij/.local/bin/marketing-sync.py
TimeoutStartSec=900
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
